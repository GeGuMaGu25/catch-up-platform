<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.0.1</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.18.0"/> 
        <PackageReference Include="EntityFrameworkCore" Version="10.0.13"/>
        <PackageReference Include="EntityFrameworkCore.Relational" Version="10.0.13"/>
        <PackageReference Include="EntityFrameworkCore.Design" Version="10.0.13">
                <PrivateAssets>all</PrivateAssets>
                <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9"/>
        <PackageReference Include="Humanizer" Version="3.0.10"/>
    </ItemGroup>

</Project>
